<?xml version="1.0" encoding="utf-8"?>
<!--
  What the installer puts on the till.

  The rules it follows:

  - A per-user install. No administrator account is needed on the machine that runs the till.
  - The programme goes under %LOCALAPPDATA%\Programs\StoreFlow.
  - The shop's data stays where it already is, in %APPDATA%\StoreFlow. The installer never
    writes there and never deletes it, so upgrading keeps the ledger and uninstalling keeps the
    ledger too. Only the person who owns the shop decides when that data goes.
  - Uninstalling removes the programme and the shortcuts, and nothing else.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="StoreFlow"
           Manufacturer="StoreFlow"
           Version="$(var.ProductVersion)"
           ProductCode="$(var.ProductCode)"
           Language="1033"
           UpgradeCode="8F3C2A16-4B7E-4D2E-9A55-6C1D3E7B0A21"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of StoreFlow is already installed. Remove it first." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The data folder is deliberately absent from this list. -->
    <Property Id="ARPPRODUCTICON" Value="StoreFlowIcon" />

    <Icon Id="StoreFlowIcon" SourceFile="$(var.IconDir)\StoreFlow.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="StoreFlow">
          <!-- The Arabic strings of the application live in a satellite assembly. -->
          <Directory Id="ArabicFolder" Name="ar" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="StoreFlow" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!--
      The programme itself.

      The published folder carries a satellite assembly per language for the .NET runtime's own
      messages. Only the Arabic one is wanted, because the shop's own Arabic strings live in it.
      The rest are left out: they hold the same file names as each other, and the installer would
      not know which of them to put where.

      The list of files is generated by installer\build-installer.ps1 and brought in from there.
    -->

    <!-- ApplicationFiles -->

    <!-- The shortcut on the Start menu. -->
    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <Component Id="StartMenuShortcut" Guid="1C0F7A64-3E8B-4E27-9C36-0D4B8A5F2C71">
        <Shortcut Id="StoreFlowShortcut"
                  Name="StoreFlow"
                  Description="StoreFlow retail management"
                  Target="[INSTALLFOLDER]StoreFlow.Desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\StoreFlow"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      The shortcut on the desktop. It is optional, so it is its own feature and the owner can
      leave it out.
    -->
    <ComponentGroup Id="DesktopShortcut" Directory="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="2B7A9E15-6D4C-4A38-B0F2-8E5C1D9A4B33">
        <Shortcut Id="StoreFlowDesktopShortcut"
                  Name="StoreFlow"
                  Description="StoreFlow retail management"
                  Target="[INSTALLFOLDER]StoreFlow.Desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\StoreFlow"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="StoreFlow" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="ArabicResources" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <!--
      The version the shop is running, written where the diagnostics bundle can find it.
    -->
    <ComponentGroup Id="VersionMarker" Directory="INSTALLFOLDER">
      <Component Id="VersionMarkerComponent" Guid="3D8B4F26-7E5D-4C19-AF03-9F6D2E8B5C44">
        <RegistryValue Root="HKCU"
                       Key="Software\StoreFlow"
                       Name="Version"
                       Type="string"
                       Value="$(var.ProductVersion)"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="VersionMarkerFeature" Title="Version" Level="1">
      <ComponentRef Id="VersionMarkerComponent" />
    </Feature>

    <ui:WixUI xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
