<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    The installer for StoreFlow.

    It is built by installer\build-installer.ps1, not by the solution build, because a .wixproj
    needs the WiX SDK and the solution is built by people who only want to run the tests.

    The installer is a per-user install on purpose. A shop does not have a Windows administrator
    account on the till, and an installer that needs one is an installer that does not get used.
  -->

  <PropertyGroup>
    <OutputName>StoreFlow</OutputName>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <InstallerPlatform>x64</InstallerPlatform>
    <Configuration>Release</Configuration>
    <!--
      ICE61 warns that the file list holds more than one file with the same short name, which is
      what happens when a folder and a file share a name.

      ICE38 wants a registry key as the key path of every component that installs into the user
      profile. The files themselves are the key path here, which is what a per-user package wants:
      the installer knows what it installed without needing a registry entry for every one of the
      four hundred and fifty files.

      ICE60 wants every file to say what language it is in. The installer carries one language.

      ICE91 warns that a per-user install does not vary with ALLUSERS, which is exactly what this
      package is: it is always per-user.
    -->
    <SuppressIces>ICE38;ICE60;ICE61;ICE64;ICE91</SuppressIces>
    <NoWarn>$(NoWarn);WIX0001</NoWarn>

    <!--
      Only the generated source is compiled. The folder also holds the template it is generated
      from, and a folder with two packages in it is two entry sections, which WiX refuses.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The publish folder the build script fills before this project is built. -->
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\</PublishDir>
    <IconDir Condition="'$(IconDir)' == ''">$(MSBuildThisFileDirectory)..\..\src\StoreFlow.Desktop\Assets\</IconDir>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <!-- The installer source, generated from the template by the build script. -->
    <ProductWxs Condition="'$(ProductWxs)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\installer\Product.wxs</ProductWxs>
    <!--
      The identity of this build. WiX would work one out from the contents of the package, which
      means that rebuilding the same version would produce a different identity and the shop
      would be left with two copies of the same version installed. The build script works it out
      from the version instead, so the same version is always the same product and a new version
      is always a new product.
    -->
    <ProductCode Condition="'$(ProductCode)' == ''">00000000-0000-0000-0000-000000000000</ProductCode>
    <DefineConstants>ProductVersion=$(ProductVersion);ProductCode=$(ProductCode);PublishDir=$(PublishDir);IconDir=$(IconDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The installer source is generated by installer\build-installer.ps1 from the template in this
      folder, because the list of files to install comes from the published programme. Building
      the template on its own fails on purpose: the file list would be missing.
    -->
    <Compile Include="$(ProductWxs)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dialog set: the folder picker and the progress bar the owner sees. -->
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

</Project>
