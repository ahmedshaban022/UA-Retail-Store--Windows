<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The instrument that asks the updater's own service to install a published release, without
    installing anything.

    It was written when a release cycle's download was interrupted, and the question was whether
    the programme's ten-second HTTP timeout was cutting a 56 MB download short. The probe uses the
    programme's own service and the programme's own client, and it answers that question in
    sixteen seconds and four tenths.

    It is not part of the solution: it is a measuring instrument, not part of the product, and
    nobody running the tests needs it built.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>StoreFlow.UpdateProbe</RootNamespace>
    <AssemblyName>StoreFlow.UpdateProbe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1848</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StoreFlow.Infrastructure\StoreFlow.Infrastructure.csproj" />
  </ItemGroup>

</Project>
