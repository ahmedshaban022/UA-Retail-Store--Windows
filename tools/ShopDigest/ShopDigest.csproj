<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The instrument that says what a shop's database holds, so that the release cycle can answer
    the only question that matters about an upgrade: did the shop's data come through it untouched?

    The bytes of the database file cannot answer that. The shop runs SQLite in WAL mode, so the
    file changes when the programme closes even when nothing was written to it. The content does
    not change, and that is what this tool prints and hashes.

    It is not part of the solution: it is a measuring instrument, not part of the product, and
    nobody running the tests needs it built. tools\update-cycle.ps1 builds and runs it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>StoreFlow.Tools.ShopDigest</RootNamespace>
    <AssemblyName>ShopDigest</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
