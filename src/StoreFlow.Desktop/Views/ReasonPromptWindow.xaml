<Window x:Class="StoreFlow.Desktop.Views.ReasonPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StoreFlow.Desktop.Views"
        Title="{Binding Title}"
        Width="480"
        Height="260"
        MinWidth="420"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="ReasonPromptWindow"
        Background="{DynamicResource Surface.Canvas}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
      views:EscapeKey.Command="{Binding CancelCommand}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,16">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Title}" />
    </Border>

    <StackPanel Grid.Row="1" Margin="24,18,24,0">
      <TextBlock Text="{Binding Label}" Style="{StaticResource Type.FieldLabel}" />
      <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               Height="{DynamicResource Size.MultilineFieldHeight}"
               VerticalScrollBarVisibility="Auto"
               AutomationProperties.AutomationId="ReasonPrompt.Reason" />
      <TextBlock Text="{Binding ErrorMessage}"
                 Style="{StaticResource Type.Error}"
                 AutomationProperties.AutomationId="ReasonPrompt.Error"
                 Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
    </StackPanel>

    <Border Grid.Row="2"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="24,12"
            Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="1"
                Content="{Binding CancelText}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Ghost}"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="ReasonPrompt.Cancel" />

        <Button Grid.Column="2"
                Content="{Binding AcceptText}"
                Command="{Binding AcceptCommand}"
                Style="{StaticResource Button.Primary}"
                AutomationProperties.AutomationId="ReasonPrompt.Accept" />
      </Grid>
    </Border>
  </Grid>
</Window>
