<Window x:Class="StoreFlow.Desktop.Views.ReturnDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820"
        Height="620"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="ReturnDialog"
        Background="{DynamicResource Surface.Canvas}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,16">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Title}" />
        <TextBlock Text="{Binding Hint}" Style="{StaticResource Type.Caption}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="24,18,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- The lines of the invoice -->
      <DataGrid x:Name="ReturnLinesGrid"
                Grid.Row="0"
                AutomationProperties.AutomationId="ReturnDialogLines"
                ItemsSource="{Binding Lines}"
                EnableColumnVirtualization="False"
                IsReadOnly="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Width="1.8*" MinWidth="160" IsReadOnly="True">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding ProductHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.Binding>
              <Binding Path="Product" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="85" IsReadOnly="True">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding QuantityHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="SoldQuantity" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="85" IsReadOnly="True">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding ReturnedHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="ReturnedQuantity" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="85" IsReadOnly="True">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding RemainingHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="RemainingQuantity" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <!-- The quantity the operator types -->
          <DataGridTemplateColumn Width="110">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding ReturnQuantityHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                         FlowDirection="LeftToRight"
                         TextAlignment="Left"
                         AutomationProperties.AutomationId="ReturnDialogQuantity" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- The condition of the goods -->
          <DataGridTemplateColumn Width="130">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding ConditionHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsResellable, Mode=TwoWay}"
                          AutomationProperties.AutomationId="ReturnDialogCondition"
                          Content="{Binding ConditionText}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Width="120" IsReadOnly="True">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding RefundHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="Refund" Converter="{StaticResource Money}" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- The reason and the way the money goes back -->
      <Grid Grid.Row="1" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <TextBlock Text="{Binding ReasonLabel}" Style="{StaticResource Type.FieldLabel}" />
          <TextBlock Text="{Binding ReasonHint}" Style="{StaticResource Type.Caption}" Foreground="{DynamicResource Text.Muted}" />
          <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   Height="64"
                   VerticalScrollBarVisibility="Auto"
                   AutomationProperties.AutomationId="ReturnDialogReason" />
        </StackPanel>

        <StackPanel Grid.Column="1" MinWidth="200">
          <TextBlock Text="{Binding MethodLabel}" Style="{StaticResource Type.FieldLabel}" />
          <ComboBox ItemsSource="{Binding Methods}"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Method"
                    AutomationProperties.AutomationId="ReturnDialogMethod">
            <ComboBox.SelectedValue>
              <Binding Path="RefundMethod" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
            </ComboBox.SelectedValue>
          </ComboBox>

          <TextBlock Text="{Binding TotalLabel}" Style="{StaticResource Type.FieldLabel}" Margin="0,12,0,0" />
          <TextBlock Text="{Binding RefundTotal, Converter={StaticResource Money}}"
                     Style="{StaticResource Type.Numeric}"
                     AutomationProperties.AutomationId="ReturnDialogTotal" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="24,12"
            Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource Type.Error}"
                   AutomationProperties.AutomationId="ReturnDialogStatus"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

        <Button Grid.Column="1"
                Content="{Binding CancelText}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Ghost}"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="ReturnDialogCancel" />

        <Button Grid.Column="2"
                Content="{Binding PostText}"
                Command="{Binding PostCommand}"
                Style="{StaticResource Button.Primary}"
                AutomationProperties.AutomationId="ReturnDialogPost" />
      </Grid>
    </Border>
  </Grid>
</Window>
