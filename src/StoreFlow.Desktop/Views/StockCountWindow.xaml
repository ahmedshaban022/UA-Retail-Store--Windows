<Window x:Class="StoreFlow.Desktop.Views.StockCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StoreFlow.Desktop.Views"
        Title="{Binding Title}"
        Width="820"
        Height="560"
        MinWidth="740"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="StockCountWindow"
        Background="{DynamicResource Surface.Canvas}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
      views:EscapeKey.Command="{Binding CancelCommand}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,16">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Title}" />
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,14">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Type.FieldLabel}" />
        <TextBox Text="{Binding BusinessDateText, UpdateSourceTrigger=PropertyChanged}"
                 Width="140"
                 HorizontalAlignment="Left"
                 FlowDirection="LeftToRight"
                 TextAlignment="Left"
                 AutomationProperties.AutomationId="StockCount.Date" AutomationProperties.Name="{Binding DateLabel}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="24,12,24,0">
      <DataGrid x:Name="LinesGrid"
                AutomationProperties.AutomationId="StockCount.Lines" AutomationProperties.Name="{Binding Title}"
                ItemsSource="{Binding Lines}"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                EnableColumnVirtualization="False"
                RowHeight="{DynamicResource Size.EditorRowHeight}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="2*">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding ProductLabel}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding DataContext.Products, Source={x:Reference LinesGrid}}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          AutomationProperties.AutomationId="StockCount.Line.Product" AutomationProperties.Name="{Binding DataContext.ProductLabel, Source={x:Reference LinesGrid}}">
                    <ComboBox.SelectedValue>
                        <Binding Path="ProductId" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
                    </ComboBox.SelectedValue>
                </ComboBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Width="130">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding CountedLabel}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="StockCount.Line.Counted" AutomationProperties.Name="{Binding DataContext.CountedLabel, Source={x:Reference LinesGrid}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{Binding DataContext.RemoveLineText, Source={x:Reference LinesGrid}}"
                        Command="{Binding DataContext.RemoveLineCommand, Source={x:Reference LinesGrid}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource Button.Ghost}"
                        Padding="8,0"
                        MinWidth="0"
                        AutomationProperties.AutomationId="StockCount.RemoveLine" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Border Grid.Row="3"
            Margin="24,12,24,0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            Padding="12,10">
      <Button Content="{Binding AddLineText}"
              Command="{Binding AddLineCommand}"
              Style="{StaticResource Button.Ghost}"
              HorizontalAlignment="Left"
              AutomationProperties.AutomationId="StockCount.AddLine" />
    </Border>

    <Border Grid.Row="4"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="24,12"
            Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource Type.Error}"
                   AutomationProperties.AutomationId="StockCount.Status"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

        <Button Grid.Column="1"
                Content="{Binding CancelText}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Ghost}"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="StockCount.Cancel" />

        <Button Grid.Column="2"
                Content="{Binding SaveText}"
                Command="{Binding SaveCommand}"
                Style="{StaticResource Button.Ghost}"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="StockCount.Save" />

        <Button Grid.Column="3"
                Content="{Binding SubmitText}"
                Command="{Binding SubmitCommand}"
                Style="{StaticResource Button.Primary}"
                AutomationProperties.AutomationId="StockCount.Submit" />
      </Grid>
    </Border>
  </Grid>
</Window>
