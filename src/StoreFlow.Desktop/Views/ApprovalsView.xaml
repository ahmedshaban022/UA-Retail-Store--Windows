<UserControl x:Class="StoreFlow.Desktop.Views.ApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <DataGrid x:Name="ApprovalsGrid"
                AutomationProperties.AutomationId="Approvals.Grid"
                ItemsSource="{Binding Requests}"
                SelectedItem="{Binding SelectedRequest}"
                IsReadOnly="True"
                EnableColumnVirtualization="False"
                CellStyle="{StaticResource DataGrid.Cell.Tight}"
                ColumnHeaderStyle="{StaticResource DataGrid.Header.Tight}"
                Margin="0,12,0,0">
        <DataGrid.Columns>
          <DataGridTextColumn Width="150"
                              Binding="{Binding When}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding WhenLabel}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn Width="160"
                              Binding="{Binding RequestedBy}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding RequestedByLabel}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn Width="1*" MinWidth="160"
                              Binding="{Binding Discount}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DiscountLabel}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>

            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Width="130"
                              Binding="{Binding CartTotal}"
                              ElementStyle="{StaticResource Type.Numeric}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding CartTotalLabel}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn Width="170"
                              Binding="{Binding Status}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding EmptyText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{Binding StatusMessage}"
                 Style="{StaticResource Type.Caption}"
                 AutomationProperties.AutomationId="Approvals.Status"
                 VerticalAlignment="Center"
                 Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="{Binding RejectLabel}"
                Command="{Binding RejectCommand}"
                IsEnabled="{Binding CanDecide}"
                Style="{StaticResource Button.Ghost}"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="Approvals.Reject" />

        <Button Content="{Binding ApproveLabel}"
                Command="{Binding ApproveCommand}"
                IsEnabled="{Binding CanDecide}"
                Style="{StaticResource Button.Primary}"
                AutomationProperties.AutomationId="Approvals.Approve" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
