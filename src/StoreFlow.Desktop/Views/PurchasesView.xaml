<UserControl x:Class="StoreFlow.Desktop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The screen's own toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="0,10,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
          The filters wrap rather than push the commands off the edge of the screen. The Arabic
          words are wider than the English ones, and a toolbar that runs out of room has to give
          something back: the filter line wraps onto a second row instead of the last button
          being cut off.
        -->
        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Search -->
          <Grid Width="220" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="Purchases.Search" AutomationProperties.Name="{Binding SearchPlaceholder}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding SearchPlaceholder}"
                       IsHitTestVisible="False"
                       Margin="11,8"
                       Foreground="{DynamicResource Text.Muted}"
                       Visibility="{Binding HasNoSearchText, Converter={StaticResource BooleanToVisibility}}" />
          </Grid>

          <!-- Date range -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding FromLabel}" Style="{StaticResource Type.FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding FromDateText, UpdateSourceTrigger=PropertyChanged}"
                     Width="110"
                     AutomationProperties.AutomationId="Purchases.From" AutomationProperties.Name="{Binding FromLabel}" />

            <TextBlock Text="{Binding ToLabel}" Style="{StaticResource Type.FieldLabel}" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Text="{Binding ToDateText, UpdateSourceTrigger=PropertyChanged}"
                     Width="110"
                     AutomationProperties.AutomationId="Purchases.To" AutomationProperties.Name="{Binding ToLabel}" />
          </StackPanel>

          <!-- Supplier -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SupplierFilterLabel}" Style="{StaticResource Type.FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding Suppliers}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Id"
                      MinWidth="160"
                      AutomationProperties.AutomationId="Purchases.Supplier" AutomationProperties.Name="{Binding SupplierFilterLabel}">
                <ComboBox.SelectedValue>
                    <Binding Path="SupplierId" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
                </ComboBox.SelectedValue>
            </ComboBox>
          </StackPanel>

        </WrapPanel>

        <!-- Commands -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Content="{Binding EditText}"
                  Command="{Binding EditSelectedCommand}"
                  IsEnabled="{Binding CanEditSelected}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Purchases.Edit" />

          <Button Content="{Binding PostText}"
                  Command="{Binding PostSelectedCommand}"
                  IsEnabled="{Binding CanEditSelected}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Purchases.Post" />

          <Button Content="{Binding ReverseText}"
                  Command="{Binding ReverseSelectedCommand}"
                  IsEnabled="{Binding CanReverseSelected}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Purchases.Reverse" />

          <Button Content="{Binding ExportText}"
                  Command="{Binding ExportCommand}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Purchases.Export" />

          <Button Content="{Binding NewText}"
                  Command="{Binding NewPurchaseCommand}"
                  Style="{StaticResource Button.Primary}"
                  AutomationProperties.AutomationId="Purchases.New" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The register -->
    <Grid Grid.Row="1">
      <DataGrid x:Name="PurchasesGrid"
                AutomationProperties.AutomationId="Purchases.Grid" AutomationProperties.Name="{Binding Title}"
                ItemsSource="{Binding Purchases}"
                SelectedItem="{Binding SelectedPurchase, Mode=TwoWay}"
                EnableColumnVirtualization="False"
                Margin="0,12,0,0">
        <DataGrid.Columns>
          <DataGridTextColumn Width="135">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding NumberHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="Number" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="105">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DateHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="BusinessDate" StringFormat="{}{0:yyyy-MM-dd}" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="1.6*" MinWidth="140">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Cell}">
                <Setter Property="ToolTip" Value="{Binding SupplierName}" />
              </Style>
            </DataGridTextColumn.ElementStyle>

            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding SupplierHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.Binding>
              <Binding Path="SupplierName" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="85">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding LinesHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="LineCount" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="110">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding QuantityHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="TotalQuantity" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="125">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding TotalHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="Total" Converter="{StaticResource Money}" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="135">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding ReversesHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="ReversesDocumentId" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTemplateColumn Width="145">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding StatusHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge.Status}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Status, Converter={StaticResource InventoryLabel}}"
                             Foreground="{DynamicResource Text.Secondary}"
                             FontSize="{DynamicResource Font.Size.Small}"
                             FontWeight="SemiBold" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Nothing in the register yet -->
      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding EmptyText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>

      <!-- The search found nothing -->
      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding HasNoMatches, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding NoMatchesText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>
    </Grid>

    <!-- The message the last action left behind -->
    <TextBlock Grid.Row="2"
               Text="{Binding StatusMessage}"
               Style="{StaticResource Type.Caption}"
               AutomationProperties.AutomationId="Purchases.Status"
               Margin="0,10,0,0"
               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
  </Grid>
</UserControl>
