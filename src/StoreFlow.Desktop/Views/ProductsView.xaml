<UserControl x:Class="StoreFlow.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StoreFlow.Desktop.Controls"
             TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The screen's own toolbar. The shell's command bar carries the application, this one carries
         the catalogue. -->
    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="0,10,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Search -->
        <Grid Grid.Column="0" Width="300" VerticalAlignment="Center">
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.AutomationId="Products.Search"
                   VerticalAlignment="Center" />
          <TextBlock Text="{Binding SearchPlaceholder}"
                     IsHitTestVisible="False"
                     Margin="11,8"
                     Foreground="{DynamicResource Text.Muted}"
                     Visibility="{Binding HasNoSearchText, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>

        <!-- Show inactive -->
        <CheckBox Grid.Column="1"
                  Content="{Binding ShowInactiveText}"
                  IsChecked="{Binding IncludeInactive}"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0"
                  AutomationProperties.AutomationId="Products.ShowInactive" />

        <!-- Commands -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding EditText}"
                  Command="{Binding EditSelectedCommand}"
                  IsEnabled="{Binding CanEditSelected}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Products.Edit" />

          <Button Content="{Binding DeactivateText}"
                  Command="{Binding ToggleActiveCommand}"
                  IsEnabled="{Binding CanEditSelected}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Products.Deactivate" />

          <Button Content="{Binding ImportText}"
                  Command="{Binding ImportCommand}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Products.Import" />

          <Button Content="{Binding ExportText}"
                  Command="{Binding ExportCommand}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Products.Export" />

          <Button Content="{Binding NewProductText}"
                  Command="{Binding NewProductCommand}"
                  Style="{StaticResource Button.Primary}"
                  AutomationProperties.AutomationId="Products.New" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The catalogue -->
    <Grid Grid.Row="1">
      <DataGrid x:Name="ProductsGrid"
                AutomationProperties.AutomationId="Products.Grid"
                ItemsSource="{Binding Products}"
                SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                EnableColumnVirtualization="False"
                Margin="0,12,0,0">
        <!--
          The heading of a column is a label rather than a piece of text. A column is not part of the
          visual tree, so it inherits no data context of its own and a binding written straight on the
          column finds nothing to read. A label inside the heading is part of the tree and reads the
          label from the grid.
        -->
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="44">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Width="36"
                        Height="36"
                        CornerRadius="4"
                        Background="{DynamicResource Surface.Sunken}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1">
                  <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                         Stretch="UniformToFill" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Width="95">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding SkuHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="Sku" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="1.4*" MinWidth="120">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Cell}">
                <Setter Property="ToolTip" Value="{Binding Name}" />
              </Style>
            </DataGridTextColumn.ElementStyle>

            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding NameHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.Binding>
              <Binding Path="Name" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="1.2*" MinWidth="100">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Cell}">
                <Setter Property="ToolTip" Value="{Binding NameAr}" />
              </Style>
            </DataGridTextColumn.ElementStyle>

            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding NameArHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.Binding>
              <Binding Path="NameAr" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="120">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Cell}">
                <Setter Property="ToolTip" Value="{Binding CategoryName}" />
              </Style>
            </DataGridTextColumn.ElementStyle>

            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding CategoryHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.Binding>
              <Binding Path="CategoryName" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="90">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding UnitHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.Binding>
              <Binding Path="UnitName" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="110">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding SalePriceHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="SalePrice" Converter="{StaticResource Money}" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="110">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding CostPriceHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="CostPrice" Converter="{StaticResource Money}" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTextColumn Width="135">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding BarcodeHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" />
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.Binding>
              <Binding Path="Barcode" />
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <DataGridTemplateColumn Width="95">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding StatusHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge.Status}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding IsActive, Converter={StaticResource CatalogStatus}}"
                             Foreground="{DynamicResource Text.Secondary}"
                             FontSize="{DynamicResource Font.Size.Small}"
                             FontWeight="SemiBold" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Nothing in the catalogue yet -->
      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding EmptyText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>

      <!-- The search found nothing -->
      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding HasNoMatches, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding NoMatchesText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>
    </Grid>

    <!-- The message the last action left behind -->
    <TextBlock Grid.Row="2"
               Text="{Binding StatusMessage}"
               Style="{StaticResource Type.Caption}"
               AutomationProperties.AutomationId="Products.Status"
               Margin="0,10,0,0"
               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
  </Grid>
</UserControl>
