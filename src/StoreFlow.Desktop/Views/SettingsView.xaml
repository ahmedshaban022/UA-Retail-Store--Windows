<UserControl x:Class="StoreFlow.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display">

  <StackPanel MaxWidth="640" HorizontalAlignment="Left">

    <!-- Rebrand -->
    <Border Style="{StaticResource Surface.Card}">
      <StackPanel>
        <TextBlock Text="{Binding RebrandLabel}" Style="{StaticResource Type.Title}" />

        <TextBlock Text="{Binding ProductNameLabel}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,6" />
        <TextBox Text="{Binding ProductNameEn, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="Settings.ProductNameEn"
                 AutomationProperties.Name="{Binding ProductNameLabel}" />

        <TextBlock Text="{Binding ProductNameLabel}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,6" />
        <TextBox Text="{Binding ProductNameAr, UpdateSourceTrigger=PropertyChanged}"
                 FlowDirection="RightToLeft"
                 AutomationProperties.AutomationId="Settings.ProductNameAr"
                 AutomationProperties.Name="{Binding ProductNameLabel}" />

        <TextBlock Text="{Binding ThemeLabel}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,6" />
        <ComboBox ItemsSource="{Binding Modes}"
                  SelectedItem="{Binding SelectedModeOption}"
                  AutomationProperties.AutomationId="Settings.Theme"
                  AutomationProperties.Name="{Binding ThemeLabel}" />

        <TextBlock Text="{Binding LanguageLabel}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,6" />
        <ComboBox ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  DisplayMemberPath="NativeName"
                  AutomationProperties.AutomationId="Settings.Language"
                  AutomationProperties.Name="{Binding LanguageLabel}" />

        <Button Content="{Binding SaveLabel}"
                Command="{Binding SaveCommand}"
                Style="{StaticResource Button.Primary}"
                Margin="0,20,0,0"
                MinHeight="36"
                AutomationProperties.AutomationId="Settings.Save" />

        <TextBlock Text="{Binding StatusMessage}"
                   Style="{StaticResource Type.Caption}"
                   Foreground="{DynamicResource State.Success}"
                   Margin="0,12,0,0"
                   AutomationProperties.AutomationId="Settings.Status"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
      </StackPanel>
    </Border>

    <!-- About this programme: the version that is installed, and the way to ask whether there is a
         newer one. The update is never installed without the shop asking for it. -->
    <Border Style="{StaticResource Surface.Card}" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="{Binding AboutLabel}" Style="{StaticResource Type.Title}" />

        <TextBlock Text="{Binding VersionLabel}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,6" />
        <TextBlock Text="{Binding InstalledVersion}"
                   Style="{StaticResource Type.Body}"
                   AutomationProperties.AutomationId="Settings.Version" />

        <Button Content="{Binding CheckForUpdatesLabel}"
                Command="{Binding CheckForUpdatesCommand}"
                Style="{StaticResource Button.Primary}"
                Margin="0,20,0,0"
                MinHeight="36"
                AutomationProperties.AutomationId="Settings.CheckForUpdates" />

        <TextBlock Text="{Binding UpdateStatusMessage}"
                   Style="{StaticResource Type.Caption}"
                   Foreground="{DynamicResource Text.Muted}"
                   Margin="0,12,0,0"
                   AutomationProperties.AutomationId="Settings.UpdateStatus"
                   Visibility="{Binding UpdateStatusMessage, Converter={StaticResource StringToVisibility}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
