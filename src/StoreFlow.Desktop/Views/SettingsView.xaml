<UserControl x:Class="StoreFlow.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display">

  <StackPanel MaxWidth="640" HorizontalAlignment="Left">

    <!-- Rebrand -->
    <Border Style="{StaticResource Surface.Card}">
      <StackPanel>
        <TextBlock Text="{Binding RebrandLabel}" Style="{StaticResource Type.Title}" />

        <TextBlock Text="{Binding ProductNameLabel}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,6" />
        <TextBox Text="{Binding ProductNameEn, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding ProductNameLabel}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,6" />
        <TextBox Text="{Binding ProductNameAr, UpdateSourceTrigger=PropertyChanged}"
                 FlowDirection="RightToLeft" />

        <TextBlock Text="{Binding ThemeLabel}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,6" />
        <ComboBox ItemsSource="{Binding Modes}"
                  SelectedItem="{Binding SelectedModeOption}" />

        <TextBlock Text="{Binding LanguageLabel}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,6" />
        <ComboBox ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  DisplayMemberPath="NativeName" />

        <Button Content="{Binding SaveLabel}"
                Command="{Binding SaveCommand}"
                Style="{StaticResource Button.Primary}"
                Margin="0,20,0,0"
                MinHeight="36" />

        <TextBlock Text="{Binding StatusMessage}"
                   Style="{StaticResource Type.Caption}"
                   Foreground="{DynamicResource State.Success}"
                   Margin="0,12,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
