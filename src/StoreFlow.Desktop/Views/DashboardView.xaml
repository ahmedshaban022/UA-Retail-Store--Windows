<UserControl x:Class="StoreFlow.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display">

  <StackPanel>
    <TextBlock Text="{Binding WelcomeText}" Style="{StaticResource Type.Title}" />
    <TextBlock Text="{Binding TodaySalesLabel}"
               Style="{StaticResource Type.SectionLabel}"
               Margin="0,24,0,12" />

    <UniformGrid Columns="3" Rows="1">
      <!-- Today's sales -->
      <Border Style="{StaticResource Surface.Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="{Binding TodaySalesLabel}" Style="{StaticResource Type.Caption}" />
          <TextBlock Text="{Binding TodaySales}"
                     Style="{StaticResource Type.Display}"
                     Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <!-- Invoice count -->
      <Border Style="{StaticResource Surface.Card}" Margin="6,0">
        <StackPanel>
          <TextBlock Text="{Binding InvoicesLabel}" Style="{StaticResource Type.Caption}" />
          <TextBlock Text="{Binding TodayInvoiceCount}"
                     Style="{StaticResource Type.Display}"
                     Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <!-- Low stock -->
      <Border Style="{StaticResource Surface.Card}" Margin="12,0,0,0">
        <StackPanel>
          <TextBlock Text="{Binding LowStockLabel}" Style="{StaticResource Type.Caption}" />
          <TextBlock Text="{Binding LowStockCount}"
                     Style="{StaticResource Type.Display}"
                     Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Empty state -->
    <Border Style="{StaticResource Surface.Panel}"
            Margin="0,24,0,0"
            Padding="24"
            Visibility="{Binding HasNoSales, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock Text="{Binding EmptyStateText}"
                 Style="{StaticResource Type.Body}"
                 Foreground="{DynamicResource Text.Secondary}" />
    </Border>
  </StackPanel>
</UserControl>
