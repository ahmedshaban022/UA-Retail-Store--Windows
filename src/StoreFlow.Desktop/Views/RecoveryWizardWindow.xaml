<Window x:Class="StoreFlow.Desktop.Views.RecoveryWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="680"
        Height="620"
        MinWidth="600"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="RecoveryWizardWindow"
        Background="{DynamicResource Surface.Canvas}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,16">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Title}" />
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,18,24,18">

        <!-- The runbook -->
        <TextBlock Text="{Binding RunbookHeading}" Style="{StaticResource Type.SectionLabel}" />

        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="•" Style="{StaticResource Type.Body}" />
                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Type.Body}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Putting the shop back -->
        <TextBlock Text="{Binding RestoreHeading}"
                   Style="{StaticResource Type.SectionLabel}"
                   Margin="0,16,0,0" />

        <TextBlock Text="{Binding HelpText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0"
                   Text="{Binding ChosenPath, UpdateSourceTrigger=PropertyChanged}"
                   IsReadOnly="True"
                   AutomationProperties.AutomationId="Recovery.Path" />

          <Button Grid.Column="1"
                  Content="{Binding BrowseLabel}"
                  Command="{Binding BrowseCommand}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="8,0,0,0"
                  AutomationProperties.AutomationId="Recovery.Browse" />
        </Grid>

        <Button Content="{Binding RestoreLabel}"
                Command="{Binding RestoreCommand}"
                Style="{StaticResource Button.Primary}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                AutomationProperties.AutomationId="Recovery.Restore" />

        <TextBlock Text="{Binding StatusMessage}"
                   Style="{StaticResource Type.Body}"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0"
                   AutomationProperties.AutomationId="Recovery.Status" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="24,12"
            Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="1"
                Content="{Binding CancelLabel}"
                Command="{Binding CloseCommand}"
                Style="{StaticResource Button.Ghost}"
                AutomationProperties.AutomationId="Recovery.Close" />
      </Grid>
    </Border>
  </Grid>
</Window>
