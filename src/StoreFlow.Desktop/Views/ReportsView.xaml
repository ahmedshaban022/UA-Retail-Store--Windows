<UserControl x:Class="StoreFlow.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="0,10,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The report and the period it covers -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding KindLabel}"
                     Style="{StaticResource Type.FieldLabel}"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0" />
          <ComboBox Width="220"
                    ItemsSource="{Binding Kinds}"
                    SelectedItem="{Binding SelectedKind}"
                    DisplayMemberPath="DisplayName"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Reports.Picker" />

          <TextBlock Text="{Binding FromLabel}"
                     Style="{StaticResource Type.FieldLabel}"
                     VerticalAlignment="Center"
                     Margin="16,0,6,0" />
          <TextBox Width="120"
                   Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="Reports.From" />

          <TextBlock Text="{Binding ToLabel}"
                     Style="{StaticResource Type.FieldLabel}"
                     VerticalAlignment="Center"
                     Margin="12,0,6,0" />
          <TextBox Width="120"
                   Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="Reports.To" />

          <TextBlock Text="{Binding CashierLabel}"
                     Style="{StaticResource Type.FieldLabel}"
                     VerticalAlignment="Center"
                     Margin="12,0,6,0" />
          <ComboBox Width="160"
                    ItemsSource="{Binding Cashiers}"
                    SelectedItem="{Binding SelectedCashier}"
                    DisplayMemberPath="DisplayName"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Reports.Cashier" />
        </StackPanel>

        <!-- The commands -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Content="{Binding RunLabel}"
                  Command="{Binding RunCommand}"
                  Style="{StaticResource Button.Primary}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Reports.Run" />

          <Button Content="{Binding ExportLabel}"
                  Command="{Binding ExportCommand}"
                  Style="{StaticResource Button.Ghost}"
                  AutomationProperties.AutomationId="Reports.Export" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <DataGrid x:Name="ReportGrid"
                AutomationProperties.AutomationId="Reports.Grid"
                ItemsSource="{Binding Rows}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                EnableColumnVirtualization="False"
                CellStyle="{StaticResource DataGrid.Cell.Tight}"
                ColumnHeaderStyle="{StaticResource DataGrid.Header.Tight}"
                Margin="0,12,0,0" />

      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding EmptyText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource Type.Caption}"
                 AutomationProperties.AutomationId="Reports.Status"
                 Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

      <!-- What was counted in the drawer, so that the day's cash can be reconciled -->
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding DrawerOpeningLabel}"
                   Style="{StaticResource Type.Caption}"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0" />
        <TextBox Width="110"
                 Text="{Binding DrawerOpeningText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="Reports.DrawerOpening" />

        <TextBlock Text="{Binding DrawerCountedLabel}"
                   Style="{StaticResource Type.Caption}"
                   VerticalAlignment="Center"
                   Margin="12,0,6,0" />
        <TextBox Width="110"
                 Text="{Binding DrawerCountedText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="Reports.DrawerCounted" />

        <Button Content="{Binding RecordDrawerLabel}"
                Command="{Binding RecordDrawerCommand}"
                Style="{StaticResource Button.Ghost}"
                Margin="12,0,0,0"
                AutomationProperties.AutomationId="Reports.RecordDrawer" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
