<UserControl x:Class="StoreFlow.Desktop.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="0,10,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="280" VerticalAlignment="Center">
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.AutomationId="Audit.Search"
                   VerticalAlignment="Center" />
          <TextBlock Text="{Binding SearchPlaceholder}"
                     IsHitTestVisible="False"
                     Margin="11,8"
                     Foreground="{DynamicResource Text.Muted}"
                     Visibility="{Binding HasNoSearchText, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="{Binding EntityTypeLabel}"
                     Style="{StaticResource Type.Caption}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <ComboBox Width="180"
                    ItemsSource="{Binding EntityTypes}"
                    SelectedItem="{Binding SelectedEntityType}"
                    DisplayMemberPath="DisplayName"
                    AutomationProperties.AutomationId="Audit.EntityType" />
        </StackPanel>

        <!-- The days the trail is narrowed to, and who did it -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="{Binding FromLabel}"
                     Style="{StaticResource Type.Caption}"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0" />
          <TextBox Width="120"
                   Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="Audit.From" />

          <TextBlock Text="{Binding ToLabel}"
                     Style="{StaticResource Type.Caption}"
                     VerticalAlignment="Center"
                     Margin="12,0,6,0" />
          <TextBox Width="120"
                   Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="Audit.To" />

          <TextBlock Text="{Binding ActorLabel}"
                     Style="{StaticResource Type.Caption}"
                     VerticalAlignment="Center"
                     Margin="12,0,6,0" />
          <TextBox Width="140"
                   Text="{Binding ActorText, UpdateSourceTrigger=PropertyChanged}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="Audit.Actor" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <DataGrid x:Name="AuditGrid" AutomationProperties.AutomationId="Audit.Grid" EnableColumnVirtualization="False"
                ItemsSource="{Binding Entries}"
                Margin="0,12,0,0">
        <DataGrid.Columns>
          <DataGridTextColumn Width="180"
                              Binding="{Binding TimestampUtc, Converter={StaticResource Timestamp}}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding WhenHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
          
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Width="160"
                              Binding="{Binding Actor}" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding WhoHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn Width="200"
                              Binding="{Binding Action}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding ActionHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
          
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" >
                <Setter Property="ToolTip" Value="{Binding Action}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Width="140"
                              Binding="{Binding EntityType}" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding EntityHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn Width="2*" MinWidth="200"
                              Binding="{Binding Summary}" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding SummaryHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
          
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" >
                <Setter Property="ToolTip" Value="{Binding Summary}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding EmptyText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>
    </Grid>

    <TextBlock Grid.Row="2"
               Text="{Binding StatusMessage}"
               Style="{StaticResource Type.Caption}"
               AutomationProperties.AutomationId="Audit.Status"
               Margin="0,10,0,0"
               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
  </Grid>
</UserControl>
