<Window x:Class="StoreFlow.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ProductName}"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow"
        Background="{DynamicResource Surface.Canvas}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation rail -->
    <Border Grid.Column="0"
            Background="{DynamicResource Surface.Sunken}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12,20,12,16">
        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,20">
          <TextBlock Text="{Binding ProductName}"
                     Style="{StaticResource Type.Title}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding NavigationItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Title}"
                      CommandParameter="{Binding Key}"
                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      IsEnabled="{Binding IsAvailable}"
                      AutomationProperties.AutomationId="{Binding Key}"
                      HorizontalContentAlignment="Left"
                      Margin="0,1"
                      Padding="12,0"
                      Style="{StaticResource Button.Ghost}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Work area -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Command bar -->
      <Border Grid.Row="0"
              Background="{DynamicResource Surface.Raised}"
              BorderBrush="{DynamicResource Border.Subtle}"
              BorderThickness="0,0,0,1">
        <Grid Margin="24,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="{Binding CurrentTitle}"
                     Style="{StaticResource Type.Title}" />

          <ComboBox Grid.Column="1"
                    Width="140"
                    Margin="12,0,12,0"
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage}"
                    AutomationProperties.AutomationId="LanguagePicker"
                    DisplayMemberPath="NativeName" />

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0">
            <TextBlock Text="{Binding CurrentUserName}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Body}" />
            <TextBlock Text="·"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Muted}" />
            <TextBlock Text="{Binding CurrentRoleName}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Type.Caption}" />
          </StackPanel>

          <Button Grid.Column="3"
                  Content="{Binding LockText}"
                  Command="{Binding LockCommand}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0" />

          <Button Grid.Column="4"
                  Content="{Binding SignOutText}"
                  Command="{Binding SignOutCommand}"
                  Style="{StaticResource Button.Ghost}" />
        </Grid>
      </Border>

      <!-- Page -->
      <ContentControl Grid.Row="1"
                      Content="{Binding CurrentContent}"
                      Margin="24" />
    </Grid>
  </Grid>
</Window>
