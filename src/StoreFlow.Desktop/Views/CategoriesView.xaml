<UserControl x:Class="StoreFlow.Desktop.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="0,10,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <CheckBox Grid.Column="0"
                  Content="{Binding ShowInactiveText}"
                  IsChecked="{Binding IncludeInactive}"
                  VerticalAlignment="Center"
                  AutomationProperties.AutomationId="Categories.ShowInactive" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding EditText}"
                  Command="{Binding EditCommand}"
                  IsEnabled="{Binding CanEditSelected}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Categories.Edit" />

          <Button Content="{Binding DeactivateText}"
                  Command="{Binding ToggleActiveCommand}"
                  IsEnabled="{Binding CanEditSelected}"
                  Style="{StaticResource Button.Ghost}"
                  Margin="0,0,8,0"
                  AutomationProperties.AutomationId="Categories.Deactivate" />

          <Button Content="{Binding NewText}"
                  Command="{Binding NewCommand}"
                  Style="{StaticResource Button.Primary}"
                  AutomationProperties.AutomationId="Categories.New" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <DataGrid AutomationProperties.AutomationId="Categories.Grid" EnableColumnVirtualization="False"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                Margin="0,12,0,0">
        <DataGrid.Columns>
          <DataGridTextColumn
                              Binding="{Binding Name}"
                              Width="2*" MinWidth="160" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.NameHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn
                              Binding="{Binding NameAr}"
                              Width="2*" MinWidth="160" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.NameArHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn
                              Binding="{Binding ProductCount}"
                              Width="120">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.ProductsHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTemplateColumn Width="110">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding DataContext.StatusHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge.Status}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding IsActive, Converter={StaticResource CatalogStatus}}"
                             Foreground="{DynamicResource Text.Secondary}"
                             FontSize="{DynamicResource Font.Size.Small}"
                             FontWeight="SemiBold" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="{Binding EmptyText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>
    </Grid>

    <TextBlock Grid.Row="2"
               Text="{Binding StatusMessage}"
               Style="{StaticResource Type.Caption}"
               AutomationProperties.AutomationId="Categories.Status"
               Margin="0,10,0,0"
               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
  </Grid>
</UserControl>
