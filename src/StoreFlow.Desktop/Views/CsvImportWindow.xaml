<Window x:Class="StoreFlow.Desktop.Views.CsvImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StoreFlow.Desktop.Views"
        Title="{Binding Title}"
        Width="1180"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="CsvImportWindow"
        Background="{DynamicResource Surface.Canvas}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
      views:EscapeKey.Command="{Binding CancelCommand}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,16">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Title}" />
    </Border>

    <!-- The file and the rule -->
    <Border Grid.Row="1"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding FileLabel}" Style="{StaticResource Type.FieldLabel}" />
          <TextBox Text="{Binding FilePath}"
                   AutomationProperties.AutomationId="CsvImport.FilePath" AutomationProperties.Name="{Binding FileLabel}"
                   IsReadOnly="True"
                   FlowDirection="LeftToRight"
                   TextAlignment="Left" />

          <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Type.FieldLabel}" Margin="0,14,0,0" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="{Binding ModeCreateOnlyText}"
                         GroupName="ImportMode"
                         IsChecked="{Binding UpdateExisting, Converter={StaticResource InverseBoolean}, Mode=TwoWay}"
                         Margin="0,0,16,0"
                         AutomationProperties.AutomationId="CsvImport.ModeCreateOnly" />
            <RadioButton Content="{Binding ModeUpsertText}"
                         GroupName="ImportMode"
                         IsChecked="{Binding UpdateExisting}"
                         AutomationProperties.AutomationId="CsvImport.ModeUpsert" />
          </StackPanel>
        </StackPanel>

        <Button Grid.Column="1"
                Content="{Binding ChooseFileText}"
                Command="{Binding ChooseFileCommand}"
                Style="{StaticResource Button.Ghost}"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="CsvImport.ChooseFile" />
      </Grid>
    </Border>

    <!-- What the import would do -->
    <Grid Grid.Row="2" Margin="24,14,24,0">
      <DataGrid x:Name="CsvImportGrid" AutomationProperties.AutomationId="CsvImport.Grid" AutomationProperties.Name="{Binding Title}" EnableColumnVirtualization="False"
                ItemsSource="{Binding Rows}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="60"
                              Binding="{Binding Line}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding LineHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Width="100"
                              Binding="{Binding Action}" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding ActionHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn Width="140"
                              Binding="{Binding Sku}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding SkuHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
          
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.LeftToRight}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Width="1.8*" MinWidth="120"
                              Binding="{Binding Name}" >
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Cell}">
                <Setter Property="ToolTip" Value="{Binding Name}" />
              </Style>
            </DataGridTextColumn.ElementStyle>

            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding NameHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn Width="130"
                              Binding="{Binding Category}" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding CategoryHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn Width="100"
                              Binding="{Binding Unit}" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding UnitHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn Width="110"
                              Binding="{Binding SalePrice}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding SalePriceHeader}" Style="{StaticResource Type.ColumnValue}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn Width="2.2*" MinWidth="240"
                              Binding="{Binding Problems}" >
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Cell}">
                <Setter Property="ToolTip" Value="{Binding Problems}" />
              </Style>
            </DataGridTextColumn.ElementStyle>

            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding ProblemsHeader}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}">
        <TextBlock Text="{Binding EmptyText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>
    </Grid>

    <!-- The summary and the footer -->
    <Border Grid.Row="3"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="24,12"
            Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding SummaryText}"
                     Style="{StaticResource Type.SectionLabel}"
                     AutomationProperties.AutomationId="CsvImport.Summary"
                     Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibility}}" />
          <TextBlock Text="{Binding StatusMessage}"
                     Style="{StaticResource Type.Error}"
                     AutomationProperties.AutomationId="CsvImport.Status"
                     Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>

        <Button Grid.Column="1"
                Content="{Binding CancelText}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Ghost}"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="CsvImport.Cancel" />

        <Button Grid.Column="2"
                Content="{Binding ImportText}"
                Command="{Binding ImportCommand}"
                IsEnabled="{Binding CanImport}"
                Style="{StaticResource Button.Primary}"
                AutomationProperties.AutomationId="CsvImport.Import" />
      </Grid>
    </Border>
  </Grid>
</Window>
