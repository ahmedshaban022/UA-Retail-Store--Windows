<Window x:Class="StoreFlow.Desktop.Views.CsvImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="900"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="CsvImportWindow"
        Background="{DynamicResource Surface.Canvas}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,16">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Title}" />
    </Border>

    <!-- The file and the rule -->
    <Border Grid.Row="1"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding FileLabel}" Style="{StaticResource Type.FieldLabel}" />
          <TextBox Text="{Binding FilePath}"
                   AutomationProperties.AutomationId="CsvImport.FilePath"
                   IsReadOnly="True"
                   FlowDirection="LeftToRight"
                   TextAlignment="Left" />

          <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Type.FieldLabel}" Margin="0,14,0,0" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="{Binding ModeCreateOnlyText}"
                         GroupName="ImportMode"
                         IsChecked="{Binding UpdateExisting, Converter={StaticResource InverseBoolean}, Mode=TwoWay}"
                         Margin="0,0,16,0"
                         AutomationProperties.AutomationId="CsvImport.ModeCreateOnly" />
            <RadioButton Content="{Binding ModeUpsertText}"
                         GroupName="ImportMode"
                         IsChecked="{Binding UpdateExisting}"
                         AutomationProperties.AutomationId="CsvImport.ModeUpsert" />
          </StackPanel>
        </StackPanel>

        <Button Grid.Column="1"
                Content="{Binding ChooseFileText}"
                Command="{Binding ChooseFileCommand}"
                Style="{StaticResource Button.Ghost}"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="CsvImport.ChooseFile" />
      </Grid>
    </Border>

    <!-- What the import would do -->
    <Grid Grid.Row="2" Margin="24,14,24,0">
      <DataGrid AutomationProperties.AutomationId="CsvImport.Grid" EnableColumnVirtualization="False"
                ItemsSource="{Binding Rows}">
        <DataGrid.Columns>
          <DataGridTextColumn
                              Binding="{Binding Line}"
                              Width="60">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.LineHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Numeric}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn
                              Binding="{Binding Action}"
                              Width="100" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.ActionHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn
                              Binding="{Binding Sku}"
                              Width="140">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.SkuHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Identifier}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn
                              Binding="{Binding Name}"
                              Width="2*" MinWidth="120" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.NameHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn
                              Binding="{Binding Category}"
                              Width="130" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.CategoryHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn
                              Binding="{Binding Unit}"
                              Width="100" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.UnitHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>

          <DataGridTextColumn
                              Binding="{Binding SalePrice}"
                              Width="110">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.SalePriceHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Identifier}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>

          <DataGridTextColumn
                              Binding="{Binding Problems}"
                              Width="2*" MinWidth="120" >
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.ProblemsHeader, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Style="{StaticResource Type.SectionLabel}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Border Style="{StaticResource Surface.Panel}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Padding="32,24"
              Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}">
        <TextBlock Text="{Binding EmptyText}"
                   Style="{StaticResource Type.Body}"
                   Foreground="{DynamicResource Text.Muted}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </Border>
    </Grid>

    <!-- The summary and the footer -->
    <Border Grid.Row="3"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="24,12"
            Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding SummaryText}"
                     Style="{StaticResource Type.SectionLabel}"
                     AutomationProperties.AutomationId="CsvImport.Summary"
                     Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibility}}" />
          <TextBlock Text="{Binding StatusMessage}"
                     Style="{StaticResource Type.Error}"
                     AutomationProperties.AutomationId="CsvImport.Status"
                     Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>

        <Button Grid.Column="1"
                Content="{Binding CancelText}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Ghost}"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="CsvImport.Cancel" />

        <Button Grid.Column="2"
                Content="{Binding ImportText}"
                Command="{Binding ImportCommand}"
                IsEnabled="{Binding CanImport}"
                Style="{StaticResource Button.Primary}"
                AutomationProperties.AutomationId="CsvImport.Import" />
      </Grid>
    </Border>
  </Grid>
</Window>
