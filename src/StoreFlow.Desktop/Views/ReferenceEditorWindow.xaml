<Window x:Class="StoreFlow.Desktop.Views.ReferenceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StoreFlow.Desktop.Views"
        xmlns:controls="clr-namespace:StoreFlow.Desktop.Controls"
        Title="{Binding Title}"
        Width="460"
        Height="460"
        MinWidth="420"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        AutomationProperties.AutomationId="ReferenceEditorWindow"
        Background="{DynamicResource Surface.Canvas}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
      views:EscapeKey.Command="{Binding CancelCommand}">

  <Window.Resources>
    <DataTemplate x:Key="EditorTextField">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
    </DataTemplate>

    <DataTemplate x:Key="EditorMultilineField">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               Height="{DynamicResource Size.MultilineFieldHeight}"
               VerticalScrollBarVisibility="Auto" />
    </DataTemplate>

    <DataTemplate x:Key="EditorChoiceField">
      <ComboBox ItemsSource="{Binding Options}"
                DisplayMemberPath="DisplayName"
                SelectedValuePath="Id"
                AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}">
          <ComboBox.SelectedValue>
              <Binding Path="Value" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
          </ComboBox.SelectedValue>
      </ComboBox>
    </DataTemplate>

    <controls:EditorFieldTemplateSelector x:Key="EditorFieldSelector"
                                          TextTemplate="{StaticResource EditorTextField}"
                                          MultilineTemplate="{StaticResource EditorMultilineField}"
                                          ChoiceTemplate="{StaticResource EditorChoiceField}" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="24,16">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Type.Title}" />
    </Border>

    <StackPanel Grid.Row="1" Margin="24,16,24,0">
      <ItemsControl ItemsSource="{Binding Fields}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="{Binding Label}" Style="{StaticResource Type.FieldLabel}" />
              <ContentControl Content="{Binding}"
                              ContentTemplateSelector="{StaticResource EditorFieldSelector}" />
              <TextBlock Text="{Binding Error}"
                         Style="{StaticResource Type.Error}"
                         AutomationProperties.AutomationId="{Binding ErrorAutomationId}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource Type.Error}"
                 AutomationProperties.AutomationId="ReferenceEditor.Status"
                 Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
    </StackPanel>

    <Border Grid.Row="2"
            Background="{DynamicResource Surface.Raised}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="24,12"
            Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{Binding CancelText}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource Button.Ghost}"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="ReferenceEditor.Cancel" />
        <Button Content="{Binding SaveText}"
                Command="{Binding SaveCommand}"
                Style="{StaticResource Button.Primary}"
                AutomationProperties.AutomationId="ReferenceEditor.Save" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
