<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>StoreFlow.Desktop</RootNamespace>
    <AssemblyName>StoreFlow.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\StoreFlow.ico</ApplicationIcon>
    <Product>StoreFlow</Product>
    <AssemblyTitle>StoreFlow</AssemblyTitle>
    <Company>StoreFlow</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreFlow.Application\StoreFlow.Application.csproj" />
    <ProjectReference Include="..\StoreFlow.Infrastructure\StoreFlow.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Arabic face ships with the application rather than with Windows, so a shop PC needs
         no font installation and the interface looks the same on every machine. -->
    <Resource Include="Fonts\Tajawal-Regular.ttf" />
    <Resource Include="Fonts\Tajawal-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\StoreFlow-256.png" />
    <None Include="Fonts\Tajawal-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
