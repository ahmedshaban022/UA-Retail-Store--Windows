<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Base layer: typography, spacing and containers.

    No literal colour appears in this file. Every colour is a DynamicResource pointing at a semantic
    role that the theme engine fills in at run time, which is what lets the whole application repaint
    when the owner changes the theme, with no restart and no lost window state.
  -->

  <!-- Typography -->

  <!--
    Text that does not fit the space it is given is shortened with an ellipsis rather than sliced
    through the middle of a letter. A table cell is the usual case: the column is a fixed width and
    the value beside it is not, so without this the value would be cut by the next column and the
    reader would be left guessing what the missing letters were.

    The rule applies to the base style on purpose, so every label, heading and figure in the
    application behaves the same way. Styles that wrap their text - the caption and everything
    built on it - are exempt, because a wrapped line is never cut.
  -->
  <Style x:Key="Type.Body" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <Style x:Key="Type.Title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Body}">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Type.Display" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Body}">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    Small print. It wraps rather than being cut, because a caption in a table cell or a message
    under a form is often longer than the room it has, and a half-word is worse than a second
    line. A heading that wraps takes its column down with it, which is why the heading of a column
    is allowed to grow to two lines.
  -->
  <Style x:Key="Type.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Body}">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Type.SectionLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Caption}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>

  <!-- The label above a form field. It sits close to the field it belongs to. -->
  <Style x:Key="Type.FieldLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Caption}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- The message under a field that could not be accepted. It carries the words, not just a colour. -->
  <Style x:Key="Type.Error" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Caption}">
    <Setter Property="Foreground" Value="{DynamicResource State.Critical}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <!--
    The implicit style keeps bare TextBlocks on-brand without every screen restating it. It sets
    the type and deliberately leaves the colour alone: a label takes the colour of the thing it
    sits in, so the label of a button on the dark accent is light while a label on the page is ink.
    A style that set the colour here would win over that inheritance and paint every label in the
    application the same shade, whatever it was sitting on.

    The same care is taken over the trimming: text that does not fit is shortened with an ellipsis
    instead of being sliced, so a value in a table is never cut through by its neighbour.
  -->
  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <!--
    The text of a table cell. It is the implicit style without a colour of its own, so the cell it
    sits in still decides how it looks - which matters for a selected row, where the row's own
    colour has to win. A cell that holds free text adds a tool tip, so the whole value can be read
    by resting the pointer on it even when the column is too narrow to show it all.
  -->
  <Style x:Key="Type.Cell" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <!--
    The ink of the interface. Every window carries it, and everything inside a window inherits it
    unless it says otherwise, which is what gives a label its colour.
  -->
  <Style TargetType="{x:Type Window}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- Containers -->

  <Style x:Key="Surface.Card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Size.CornerRadius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Surface.Panel" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Size.CornerRadius}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Surface.Divider" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Status badges. Every badge carries an icon slot and a text label, never colour alone. -->
  <Style x:Key="Badge" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!--
    The state badge of a catalogue record. The word carries the state; the wash only reinforces it,
    so the badge still reads in greyscale and to a colour-blind reader.
  -->
  <Style x:Key="Badge.Status" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsActive}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--
    Numeric columns use tabular figures so digits line up vertically. The column keeps the direction
    of the page, so the amount is read first and the currency after it in Arabic, and the same way
    round in English. Forcing a left-to-right direction here would put the currency on the wrong
    side of the amount in the Arabic interface.
  -->
  <Style x:Key="Type.Numeric" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Body}">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!--
    An identifier — a stock-keeping unit code, a barcode, a phone number. These are read left to
    right even inside an Arabic line, so they are given their own direction and never reordered
    into the surrounding sentence. In a table the identifier is wrapped in a directional isolate
    instead, so that it keeps its own order and the cell still stands where the heading that names
    it stands.
  -->
  <Style x:Key="Type.Identifier" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Body}">
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="TextAlignment" Value="Left" />
  </Style>

  <!--
    A piece of text written left to right as a whole — a moment in time, a summary with a code in
    it — standing against the right-hand edge of its cell, where the heading that names it stands.
    The cell is given its own direction, because the text engine reads the whole of it that way: a
    hyphen between letters and digits, and a bracket at the end, are both part of the text and must
    not be moved to the other end of the line.
  -->
  <Style x:Key="Type.LeftToRight" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.Body}">
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!--
    The heading of a column whose figures stand against the right-hand edge of their cell. The
    heading stands over the values it names, in either direction, so that a column reads as one
    column and not as a heading floating beside its figures.
  -->
  <Style x:Key="Type.ColumnValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Type.SectionLabel}">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

</ResourceDictionary>
